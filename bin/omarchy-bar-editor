#!/bin/bash
# Omarchy Bar Editor — terminal launcher.
#
# Runs the bar editor as a TUI (stdlib curses, mouse-aware) inside the user's
# default terminal. It is a self-contained process independent of the shell,
# so a shell hot-reload on Save can never tear it down. The gear widget and
# the desktop entry wrap this with omarchy-launch-tui so it appears as a real
# application window.
set -euo pipefail

SCRIPT_DIR="$(cd "$(/usr/bin/dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

exec /usr/bin/python3 -I "$PLUGIN_DIR/editor_tui.py" "$@"
