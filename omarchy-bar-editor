def run_cmd(*args, timeout=10):
    """Run an external command and return CompletedProcess or None."""
    try:
        return subprocess.run(
            list(args), capture_output=True, text=True, timeout=timeout
        )
    except Exception:
        return None


def get_update_info():
    """Return (repo_dir, current_short_sha) when running from a git checkout, else (None, None)."""
    repo_dir = os.path.dirname(os.path.realpath(__file__))
    if not os.path.isdir(os.path.join(repo_dir, ".git")):
        return None, None
    proc = run_cmd("git", "-C", repo_dir, "rev-parse", "--short", "HEAD")
    if not proc or proc.returncode != 0:
        return repo_dir, None
    return repo_dir, proc.stdout.strip()


def get_catalog():
    """Discover available widgets and schemas from omarchy-plugin-catalog."""
    proc = run_cmd("omarchy-plugin-catalog")
    if not proc or proc.returncode != 0:
        return {}
    try:
        entries = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {}
    catalog = {}
    for e in entries:
        catalog[e.get("id")] = e
    return catalog


def get_plugin_states():
    """Retrieve installed plugins and their enabled status."""
    proc = run_cmd("omarchy", "plugin", "list", "--json")
    if not proc or proc.returncode != 0:
        return {}
    try:
        entries = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {}
    return {e.get("id"): e.get("enabled", False) for e in entries if isinstance(e, dict)}


def get_active_theme_defaults():
    """Inspect the current theme's colors.toml to provide accurate initial styling."""
    defaults = {
        "background": "#1a1b26",
        "background_alpha": "1.0",
        "text": "#c0caf5",
        "active": "#f7768e",
        "scale_with_font": "true",
        "size_horizontal": "26",
        "size_vertical": "28",
    }
    proc = run_cmd("omarchy", "theme", "current")
    if not proc or proc.returncode != 0 or not proc.stdout.strip():
        return defaults
    theme_name = proc.stdout.strip().lower().replace(" ", "-")
    theme_dir = f"/usr/share/omarchy/themes/{theme_name}"
    colors_file = os.path.join(theme_dir, "colors.toml")
    if os.path.exists(colors_file):
        try:
            with open(colors_file) as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    k, _, v = line.partition("=")
                    k = k.strip()
                    v = v.strip().strip("'\"")
                    if k == "background":
                        defaults["background"] = v
                    elif k in ("bright_foreground", "foreground") and defaults["text"] == "#c0caf5":
                        defaults["text"] = v
                    elif k == "red":
                        defaults["active"] = v
        except OSError:
            pass
    return defaults


class ShellToml:
    """Manage the [bar] section of ~/.config/omarchy/shell.toml without
    destructively rewriting unrelated sections."""

    DEFAULTS = get_active_theme_defaults()

    @classmethod
    def load(cls):
        values = dict(cls.DEFAULTS)
        content = ""
        try:
            with open(SHELL_TOML_PATH) as f:
                content = f.read()
        except OSError:
            return values, ""

        section = None
        for line in content.splitlines():
            line_str = line.strip()
            if line_str.startswith("[") and line_str.endswith("]"):
                section = line_str.strip("[]").strip()
                continue
            if section != "bar":
                continue
            if not line_str or line_str.startswith("#") or "=" not in line_str:
                continue
            key, _, val = line_str.partition("=")
            key = key.strip().replace("-", "_")
            val = val.strip().strip("'\"")
            if key in values:
                values[key] = val
        return values, content

    @classmethod
    def format_toml(cls, values, original_content=""):
        bar_block = (
            "[bar]\n"
            f'background       = "{values.get("background", cls.DEFAULTS["background"])}"\n'
            f'background-alpha = {values.get("background_alpha", cls.DEFAULTS["background_alpha"])}\n'
            f'text             = "{values.get("text", cls.DEFAULTS["text"])}"\n'
            f'active           = "{values.get("active", cls.DEFAULTS["active"])}"\n'
            f'scale-with-font  = {str(values.get("scale_with_font", cls.DEFAULTS["scale_with_font"])).lower()}\n'
            f'size-horizontal  = {values.get("size_horizontal", cls.DEFAULTS["size_horizontal"])}\n'
            f'size-vertical    = {values.get("size_vertical", cls.DEFAULTS["size_vertical"])}\n'
        )

        if not original_content.strip():
            return "# Omarchy Bar Editor managed [bar] overrides.\n" + bar_block

        lines = original_content.splitlines(keepends=True)
        in_bar = False
        start_idx = -1
        end_idx = -1

        for i, line in enumerate(lines):
            stripped = line.strip()
            if stripped.startswith("[") and stripped.endswith("]"):
                sec = stripped[1:-1].strip()
                if sec == "bar":
                    in_bar = True
                    start_idx = i
                elif in_bar:
                    end_idx = i
                    break

        if in_bar:
            if end_idx == -1:
                end_idx = len(lines)
            return "".join(lines[:start_idx] + [bar_block] + lines[end_idx:])
        else:
            return original_content.rstrip() + "\n\n" + bar_block

    @classmethod
    def save(cls, values):
        _, existing_content = cls.load()
        new_content = cls.format_toml(values, existing_content)

        os.makedirs(os.path.dirname(SHELL_TOML_PATH), exist_ok=True)
        bak = SHELL_TOML_PATH + ".bak-editor"
        if os.path.exists(SHELL_TOML_PATH):
            try:
                shutil.copy2(SHELL_TOML_PATH, bak)
            except OSError:
                pass

        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(SHELL_TOML_PATH))
        with os.fdopen(fd, "w") as f:
            f.write(new_content)
        os.replace(tmp, SHELL_TOML_PATH)
        return new_content


class WidgetConfigDialog:
    """Typed editor for one widget's options dict."""

    def __init__(self, window, widget_id, entry, catalog_info, on_save=None):
        self.window = window
        self.widget_id = widget_id
        self.entry = dict(entry)
        self.info = catalog_info or {}
        self.on_save = on_save
        self.rows = []
        self._cells = []

        self.dialog = Gtk.Dialog(modal=True, transient_for=window)
        self.dialog.set_title(f"Configure {self._display_name()}")
        self.dialog.set_default_size(520, 460)

        bwa = self.dialog.get_content_area()
        bwa.set_spacing(10)
        bwa.set_margin_top(12)
        bwa.set_margin_bottom(12)
        bwa.set_margin_start(12)
        bwa.set_margin_end(12)

        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title = Gtk.Label(halign=Gtk.Align.START)
        title.set_markup(
            f"<b><big>{GLib.markup_escape_text(self._display_name())}</big></b> "
            f"<span color='grey'>({GLib.markup_escape_text(widget_id)})</span>"
        )
        header_box.append(title)
        bwa.append(header_box)

        desc = (self.info.get("barWidget") or {}).get("description") or self.info.get("description")
        if desc:
            desc_lbl = Gtk.Label(halign=Gtk.Align.START, wrap=True)
            desc_lbl.set_markup(f"<small><span color='grey'>{GLib.markup_escape_text(str(desc))}</span></small>")
            bwa.append(desc_lbl)

        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sw.set_vexpand(True)
        bwa.append(sw)

        self.grid = Gtk.Grid()
        self.grid.set_column_spacing(10)
        self.grid.set_row_spacing(8)
        self.grid.set_margin_top(4)
        sw.set_child(self.grid)

        add_button = Gtk.Button(label="Add custom option")
        add_button.connect("clicked", lambda *_: self._add_row("", "", None))
        bwa.append(add_button)

        self.dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        ok = self.dialog.add_button("Save", Gtk.ResponseType.OK)
        ok.add_css_class("suggested-action")

        self.dialog.connect("response", self._on_response)
        self._build_rows()

    def _display_name(self):
        bw = self.info.get("barWidget") or {}
        return bw.get("displayName") or self.info.get("name") or self.widget_id

    def _build_rows(self):
        bw = self.info.get("barWidget") or {}
        schema = bw.get("schema") or []
        defaults = bw.get("defaults") or {}
        known = {s.get("key"): s for s in schema if isinstance(s, dict) and s.get("key")}
        keys = set(self.entry.keys()) | set(known.keys()) | set(defaults.keys())
        keys.discard("id")

        for key in sorted(keys):
            spec = known.get(key)
            default_val = spec.get("defaultValue") if spec else defaults.get(key)
            value = self.entry.get(key, default_val)
            self._add_row(key, value, spec)

    def _add_row(self, key, value, spec):
        row_index = len(self.rows)
        row = {"key": key, "container": None, "spec": spec, "kind": "text", "orig_type": type(value) if value is not None else None}

        key_entry = Gtk.Entry(text=key if key else "")
        key_entry.set_placeholder_text("Option key")

        if spec and spec.get("type") == "boolean":
            container = Gtk.Switch(active=bool(value))
            row["kind"] = "bool"
            container.set_halign(Gtk.Align.START)
        elif spec and spec.get("type") == "integer":
            lo = spec.get("min", 0)
            hi = spec.get("max", 100000)
            step = spec.get("step", 1)
            try:
                v = int(value)
            except (TypeError, ValueError):
                v = lo
            container = Gtk.SpinButton.new_with_range(lo, hi, step)
            container.set_value(v)
            row["kind"] = "int"
        elif spec and spec.get("type") == "enum":
            options = [str(o) for o in (spec.get("options") or [])]
            v = str(value) if value is not None else ""
            model = Gtk.StringList.new(options)
            container = Gtk.DropDown(model=model)
            if v in options:
                container.set_selected(options.index(v))
            row["kind"] = "enum"
            row["options"] = options
        elif spec and spec.get("type") == "multiselect":
            selected = set(value or [])
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            checkboxes = {}
            for opt in (spec.get("options") or []):
                val = opt.get("value") if isinstance(opt, dict) else opt
                label_ = opt.get("label") if isinstance(opt, dict) else str(opt)
                cb = Gtk.CheckButton(label=label_)
                cb.set_active(str(val) in {str(s) for s in selected})
                checkboxes[cb] = val
                box.append(cb)
            container = box
            row["kind"] = "multiselect"
            row["checkboxes"] = checkboxes
        else:
            container = Gtk.Entry()
            if value is not None:
                container.set_text(str(value))
            row["kind"] = "text"

        row["container"] = container
        row["key_entry"] = key_entry
        row["row_index"] = row_index
        self.rows.append(row)
        self._rebuild_grid()

    def _remove_row(self, target_row):
        if target_row in self.rows:
            self.rows.remove(target_row)
            self._rebuild_grid()

    def _rebuild_grid(self):
        for child in self._cells:
            self.grid.remove(child)
        self._cells = []

        for i, r in enumerate(self.rows):
            r["row_index"] = i
            cell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)

            key_entry = r["key_entry"]
            key_entry.set_hexpand(True)
            h.append(key_entry)

            btn_del = Gtk.Button.new_from_icon_name("list-remove-symbolic")
            btn_del.add_css_class("flat")
            btn_del.set_tooltip_text("Remove option")
            btn_del.connect("clicked", lambda _b, tr=r: self._remove_row(tr))
            h.append(btn_del)
            cell.append(h)

            spec = r.get("spec")
            if spec and spec.get("label"):
                label = Gtk.Label(halign=Gtk.Align.START)
                label.set_markup(f"<small><b>{GLib.markup_escape_text(str(spec['label']))}</b></small>")
                cell.append(label)

            cell.append(r["container"])
            self.grid.attach(cell, 0, i, 1, 1)
            self._cells.append(cell)

    def _read_row(self, r):
        key = r["key_entry"].get_text().strip()
        if not key:
            return None, None
        kind = r["kind"]
        if kind == "bool":
            return key, r["container"].get_active()
        if kind == "int":
            return key, int(r["container"].get_value())
        if kind == "enum":
            idx = r["container"].get_selected()
            opts = r.get("options", [])
            return key, (opts[idx] if 0 <= idx < len(opts) else "")
        if kind == "multiselect":
            vals = [v for cb, v in r["checkboxes"].items() if cb.get_active()]
            return key, vals

        text = r["container"].get_text()
        if text.lower() == "true":
            return key, True
        if text.lower() == "false":
            return key, False
        if r.get("orig_type") is int and text.lstrip("-").isdigit():
            return key, int(text)
        return key, text

    def _on_response(self, dialog, response):
        if response == Gtk.ResponseType.OK:
            new_entry = {"id": self.widget_id}
            for r in self.rows:
                key, value = self._read_row(r)
                if key is None or key == "id":
                    continue
                new_entry[key] = value
            if self.on_save:
                self.on_save(new_entry)
        self.dialog.destroy()

    def present(self):
        self.dialog.present()


class AddWidgetDialog:
    """Searchable picker over the bar-widget catalog."""

    def __init__(self, window, catalog, enabled_ids, section, already_placed, cat_colors=None, on_add=None):
        self.window = window
        self.catalog = catalog
        self.enabled_ids = enabled_ids
        self.already_placed = set(already_placed or ())
        self.cat_colors = cat_colors or {}
        self.result = None
        self.on_add = on_add

        self.dialog = Gtk.Dialog(modal=True, transient_for=window)
        self.dialog.set_title(f"Add Widget to {SECTION_LABELS[section]} Section")
        self.dialog.set_default_size(580, 500)

        bwa = self.dialog.get_content_area()
        bwa.set_spacing(8)
        bwa.set_margin_top(12)
        bwa.set_margin_bottom(12)
        bwa.set_margin_start(12)
        bwa.set_margin_end(12)

        title = Gtk.Label(halign=Gtk.Align.START)
        title.set_markup(
            f"<b><big>Add widget to {SECTION_LABELS[section].lower()} section</big></b>"
        )
        bwa.append(title)

        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Search widgets by name, id, or description...")
        bwa.append(self.search)

        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sw.set_vexpand(True)
        bwa.append(sw)

        self.listbox = Gtk.ListBox()
        sw.set_child(self.listbox)

        self.dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_btn = self.dialog.add_button("Add to bar", Gtk.ResponseType.ACCEPT)
        self.add_btn.add_css_class("suggested-action")

        self.dialog.connect("response", self._on_response)
        self.search.connect("search-changed", lambda e: self._populate(e.get_text()))
        self.listbox.connect("row-activated", lambda _lb, row: self._choose(row))

        self._populate("")

    def _iter_widgets(self, query):
        query = query.strip().lower()
        allow_multi = set()
        for wid, info in self.catalog.items():
            bw = info.get("barWidget") or {}
            if bw.get("allowMultiple"):
                allow_multi.add(wid)

        for wid, info in sorted(self.catalog.items(), key=lambda kv: (kv[1].get("name") or "").lower()):
            kinds = info.get("kinds") or []
            if "bar-widget" not in kinds:
                continue
            if wid in self.already_placed and wid not in allow_multi:
                continue
            bw = info.get("barWidget") or {}
            name = bw.get("displayName") or info.get("name") or wid
            desc = bw.get("description") or ""
            if not query or query in f"{wid} {name} {desc}".lower():
                yield wid, info

    def _populate(self, query):
        while (row := self.listbox.get_row_at_index(0)) is not None:
            self.listbox.remove(row)

        first_row = None
        for wid, info in self._iter_widgets(query):
            row = Gtk.ListBoxRow()
            row_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            row_box.set_margin_top(6)
            row_box.set_margin_bottom(6)
            row_box.set_margin_start(10)
            row_box.set_margin_end(10)

            bw = info.get("barWidget") or {}
            name = bw.get("displayName") or info.get("name") or wid
            category = bw.get("category") or "System"

            dot = Gtk.Label()
            dot.set_markup(f"<span color='{self.cat_colors.get(category, '#7aa2f7')}'>\u25CF</span>")
            row_box.append(dot)

            right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            title = Gtk.Label(xalign=0)
            enabled = self.enabled_ids.get(wid, False)
            badge_color = "#9ece6a" if enabled else "grey"
            badge_text = "enabled" if enabled else "disabled"
            title.set_markup(
                f"<b>{GLib.markup_escape_text(name)}</b> "
                f"<span color='{badge_color}'><small>({badge_text})</small></span>"
            )
            right.append(title)

            desc = bw.get("description")
            if desc:
                d = Gtk.Label(xalign=0, wrap=True)
                d.set_markup(f"<small>{GLib.markup_escape_text(str(desc))}</small>")
                right.append(d)

            widl = Gtk.Label(xalign=0)
            widl.set_markup(f"<span color='grey'><small>{GLib.markup_escape_text(wid)}</small></span>")
            right.append(widl)

            row_box.append(right)
            row.set_child(row_box)
            row.widget_id = wid
            self.listbox.append(row)

            if first_row is None:
                first_row = row

        if first_row:
            self.listbox.select_row(first_row)

    def _choose(self, row):
        if row is None:
            return
        self.result = getattr(row, "widget_id", None)
        self.dialog.response(Gtk.ResponseType.ACCEPT)

    def _on_response(self, dialog, response):
        if response == Gtk.ResponseType.ACCEPT:
            wid = self.result
            if not wid:
                row = self.listbox.get_selected_row() or self.listbox.get_row_at_index(0)
                if row is not None:
                    wid = getattr(row, "widget_id", None)
            if wid and self.on_add:
                self.on_add(wid)
        self.dialog.destroy()

    def present(self):
        self.dialog.present()


class PluginManagerDialog:
    """Bulk management of enabled plugins[] and disabledPlugins[]."""

    def __init__(self, window, config, catalog, states, on_changed=None):
        self.window = window
        self.config = config
        self.catalog = catalog
        self.states = dict(states)
        self.on_changed = on_changed
        self._listbox = None
        self._search = None

        self.dialog = Gtk.Dialog(modal=True, transient_for=window)
        self.dialog.set_title("Manage Plugins")
        self.dialog.set_default_size(660, 520)

        bwa = self.dialog.get_content_area()
        bwa.set_spacing(8)
        bwa.set_margin_top(12)
        bwa.set_margin_bottom(12)
        bwa.set_margin_start(12)
        bwa.set_margin_end(12)

        title = Gtk.Label(halign=Gtk.Align.START)
        title.set_markup("<b><big>Manage plugins</big></b>")
        bwa.append(title)

        hint = Gtk.Label(
            label="First-party plugins are active unless placed in disabledPlugins[]. "
                  "Third-party plugins are active when listed in plugins[]. Changes apply on Save.",
            wrap=True,
            halign=Gtk.Align.START,
        )
        bwa.append(hint)

        self._search = Gtk.SearchEntry()
        self._search.set_placeholder_text("Search plugins...")
        self._search.connect("search-changed", lambda e: self._populate(e.get_text()))
        bwa.append(self._search)

        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sw.set_vexpand(True)
        bwa.append(sw)

        self._listbox = Gtk.ListBox()
        sw.set_child(self._listbox)

        self.dialog.add_button("Close", Gtk.ResponseType.CLOSE)
        self.dialog.connect("response", lambda _d, _r: self.dialog.destroy())

        self._collect_states()
        self._populate("")

    def _collect_states(self):
        plugins = self.config.get("plugins", [])
        for p in plugins:
            if isinstance(p, dict) and p.get("id"):
                self.states[p.get("id")] = True
        disabled = self.config.get("disabledPlugins", [])
        for d in disabled:
            self.states[d] = False

    def _populate(self, query):
        if self._listbox is None:
            return
        while (row := self._listbox.get_row_at_index(0)) is not None:
            self._listbox.remove(row)

        query = query.strip().lower()
        all_ids = set(self.states.keys()) | set(self.catalog.keys())

        for wid in sorted(all_ids):
            info = self.catalog.get(wid) or {}
            name = info.get("name") or wid
            kinds = info.get("kinds") or []
            kind_txt = ", ".join(kinds) if kinds else "service"
            hay = f"{wid} {name} {kind_txt}".lower()

            if query and query not in hay:
                continue

            enabled = bool(self.states.get(wid, False))
            row = Gtk.ListBoxRow()
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            box.set_margin_top(4)
            box.set_margin_bottom(4)
            box.set_margin_start(8)
            box.set_margin_end(8)

            sw = Gtk.Switch(active=enabled, valign=Gtk.Align.CENTER)
            sw.widget_id = wid
            sw.connect("state-set", self._on_toggle)
            box.append(sw)

            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            vbox.set_hexpand(True)
            lbl = Gtk.Label(xalign=0)
            lbl.set_markup(f"<b>{GLib.markup_escape_text(str(name))}</b>")
            vbox.append(lbl)

            sub = Gtk.Label(xalign=0)
            sub.set_markup(
                f"<span color='grey'><small>{GLib.markup_escape_text(wid)} — {GLib.markup_escape_text(kind_txt)}</small></span>"
            )
            vbox.append(sub)
            box.append(vbox)

            row.set_child(box)
            self._listbox.append(row)

    def _on_toggle(self, switch, state):
        wid = switch.widget_id
        self.states[wid] = state
        info = self.catalog.get(wid) or {}
        is_first_party = info.get("firstParty", True)

        enabled_list = [e.get("id") for e in self.config.get("plugins", []) if isinstance(e, dict) and e.get("id")]
        disabled_list = list(self.config.get("disabledPlugins", []))

        if is_first_party:
            if state:
                if wid in disabled_list:
                    disabled_list.remove(wid)
            else:
                if wid not in disabled_list:
                    disabled_list.append(wid)
            if wid in enabled_list:
                enabled_list.remove(wid)
        else:
            if state:
                if wid not in enabled_list:
                    enabled_list.append(wid)
                if wid in disabled_list:
                    disabled_list.remove(wid)
            else:
                if wid in enabled_list:
                    enabled_list.remove(wid)

        if enabled_list:
            self.config["plugins"] = [{"id": i} for i in enabled_list if i]
        else:
            self.config.pop("plugins", None)

        if disabled_list:
            self.config["disabledPlugins"] = disabled_list
        else:
            self.config.pop("disabledPlugins", None)

        if self.on_changed:
            self.on_changed()
        return False

    def present(self):
        self.dialog.present()


class ProfileDialog:
    """Save/load named bar-layout profiles."""

    def __init__(self, window, on_save, on_load):
