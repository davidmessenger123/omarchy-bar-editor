    def _on_col_dialog_notify(self, swatch, entry):
        if self._loading:
            return
        rgba = swatch.get_rgba()
        hexv = "#{:02x}{:02x}{:02x}".format(
            int(round(rgba.red * 255)),
            int(round(rgba.green * 255)),
            int(round(rgba.blue * 255)),
        )
        if entry.get_text() != hexv:
            entry.set_text(hexv)
            self._mark_toml_dirty()

    def _on_swatch(self, entry, swatch):
        if self._loading:
            return
        rgba = swatch.get_rgba()
        hexv = "#{:02x}{:02x}{:02x}".format(
            int(round(rgba.red * 255)),
            int(round(rgba.green * 255)),
            int(round(rgba.blue * 255)),
        )
        if entry.get_text() != hexv:
            entry.set_text(hexv)
            self._mark_toml_dirty()

    def _on_color_text(self, entry, swatch):
        if self._loading:
            return
        self._mark_toml_dirty()
        text = entry.get_text().strip()
        if re.match(r"^#[0-9a-fA-F]{6}$", text):
            try:
                rgba = Gdk.RGBA()
                rgba.red = int(text[1:3], 16) / 255.0
                rgba.green = int(text[3:5], 16) / 255.0
                rgba.blue = int(text[5:7], 16) / 255.0
                rgba.alpha = 1.0
                swatch.set_rgba(rgba)
            except Exception:
                pass

    def _mark_toml_dirty(self):
        if self._loading:
            return
        self._toml_dirty = True
        self.dirty = True
        self._status("Unsaved styling changes")

    def _build_section(self, sec):
        frame = Gtk.Frame(label=f"{SECTION_LABELS[sec]} section")
        self.section_frames[sec] = frame
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_margin_top(8)
        box.set_margin_bottom(8)
        box.set_margin_start(8)
        box.set_margin_end(8)
        frame.set_child(box)

        search = Gtk.SearchEntry()
        search.set_placeholder_text(f"Filter {SECTION_LABELS[sec].lower()} widgets...")
        search.set_hexpand(True)
        search.connect("search-changed", lambda e: self._refresh_layout())
        box.append(search)
        self.search_entries[sec] = search

        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sw.set_vexpand(True)
        sw.set_size_request(300, 360)
        box.append(sw)

        lb = Gtk.ListBox()
        sw.set_child(lb)
        self.section_boxes[sec] = lb
        self._setup_dnd(lb)

        add_btn = Gtk.Button(label=f"Add widget to {SECTION_LABELS[sec].lower()}...")
        add_btn.connect("clicked", lambda *_: self._open_add(sec))
        box.append(add_btn)
        return frame

    def _setup_dnd(self, lb):
        source = Gtk.DragSource.new()
        source.set_actions(Gdk.DragAction.MOVE)
        source.connect("prepare", self._dnd_prepare)
        lb.add_controller(source)

        target = Gtk.DropTarget.new(GObject.TYPE_STRING, Gdk.DragAction.MOVE)
        target.connect("drop", self._dnd_drop)
        target.connect("motion", lambda *_: Gdk.DragAction.MOVE)
        lb.add_controller(target)

    def _dnd_prepare(self, source, x, y):
        lb = source.get_widget()
        row = lb.get_row_at_y(int(y))
        if row is None:
            return None
        wid = getattr(row, "widget_id", None)
        entry_idx = getattr(row, "entry_index", None)
        if wid is None or entry_idx is None:
            return None
        self._dnd_payload = {"source": lb, "widget_id": wid, "src_index": entry_idx}
        return Gdk.ContentProvider.new_for_value(wid)

    def _dnd_drop(self, target, value, x, y):
        if isinstance(value, str):
            wid = value
        elif hasattr(value, "get_string"):
            try:
                wid = value.get_string()
            except Exception:
                wid = str(value)
        else:
            wid = str(value)

        payload = getattr(self, "_dnd_payload", None)
        if payload is None:
            return False

        src_lb = payload["source"]
        widget_id = payload["widget_id"]
        src_index = payload.get("src_index")

        dst_lb = target.get_widget()
        dst_row = dst_lb.get_row_at_y(int(y))
        dst_sec = self._lb_section(dst_lb)
        src_sec = self._lb_section(src_lb)

        if dst_sec is None or src_sec is None:
            return False

        src_entries = self._ordered_entries(src_sec)
        if src_index is None or src_index >= len(src_entries) or src_entries[src_index].get("id") != widget_id:
            src_index = next((i for i, e in enumerate(src_entries) if e.get("id") == widget_id), None)
        if src_index is None:
            return False

        dst_entries = self._ordered_entries(dst_sec)
        if dst_row is None:
            target_idx = len(dst_entries)
        else:
            target_idx = getattr(dst_row, "entry_index", dst_row.get_index())

        info = self.catalog.get(widget_id, {})
        bw = info.get("barWidget") or {}
        allow_multiple = bw.get("allowMultiple", False)

        if src_sec != dst_sec and not allow_multiple:
            if any(e.get("id") == widget_id for e in dst_entries):
                self._status(f"'{widget_id}' is already in {SECTION_LABELS[dst_sec].lower()} section")
                return False

        self.push_undo()
        entry = src_entries.pop(src_index)
        if src_sec == dst_sec:
            if src_index < target_idx:
                target_idx -= 1

        target_idx = max(0, min(target_idx, len(dst_entries)))
        dst_entries.insert(target_idx, entry)
        self._mark_dirty()
        self._refresh_layout()
        return True

    def _lb_section(self, lb):
        for sec, s_lb in self.section_boxes.items():
            if s_lb is lb:
                return sec
        return None

    def _widget_row(self, sec, index, entry):
        wid = entry.get("id", "")
        info = self.catalog.get(wid, {})
        bw = info.get("barWidget") or {}
        name = bw.get("displayName") or info.get("name") or wid
        category = bw.get("category") or "System"

        row = Gtk.ListBoxRow()
        row.widget_id = wid
        row.entry_index = index

        h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        h.set_margin_top(4)
        h.set_margin_bottom(4)
        h.set_margin_start(8)
        h.set_margin_end(8)

        dot = Gtk.Label()
        dot.set_markup(f"<span color='{self.CAT_COLORS.get(category, '#7aa2f7')}'>\u25CF</span>")
        h.append(dot)

        label_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        label_box.set_hexpand(True)
        t = Gtk.Label(xalign=0)
        t.set_markup(f"<b>{GLib.markup_escape_text(str(name))}</b>")
        label_box.append(t)
        s = Gtk.Label(xalign=0)
        s.set_markup(f"<span color='grey'><small>{GLib.markup_escape_text(wid)}</small></span>")
        label_box.append(s)
        h.append(label_box)

        config_btn = Gtk.Button.new_from_icon_name("document-properties-symbolic")
        config_btn.add_css_class("flat")
        config_btn.set_tooltip_text("Configure options")
        config_btn.connect("clicked", lambda *_: self._open_config(entry))
        h.append(config_btn)

        up_btn = Gtk.Button.new_from_icon_name("go-up-symbolic")
        up_btn.add_css_class("flat")
        up_btn.set_tooltip_text("Move up")
        up_btn.connect("clicked", lambda *_: self._reorder(sec, index, -1))
        h.append(up_btn)

        down_btn = Gtk.Button.new_from_icon_name("go-down-symbolic")
        down_btn.add_css_class("flat")
        down_btn.set_tooltip_text("Move down")
        down_btn.connect("clicked", lambda *_: self._reorder(sec, index, +1))
        h.append(down_btn)

        sec_i = SECTIONS.index(sec)
        if sec_i > 0:
            left_btn = Gtk.Button.new_from_icon_name("go-previous-symbolic")
            left_btn.add_css_class("flat")
            left_btn.set_tooltip_text(f"Move to {SECTION_LABELS[SECTIONS[sec_i - 1]].lower()}")
            left_btn.connect("clicked", lambda *_: self._move_section(sec, index, SECTIONS[sec_i - 1]))
            h.append(left_btn)

        if sec_i < 2:
            right_btn = Gtk.Button.new_from_icon_name("go-next-symbolic")
            right_btn.add_css_class("flat")
            right_btn.set_tooltip_text(f"Move to {SECTION_LABELS[SECTIONS[sec_i + 1]].lower()}")
            right_btn.connect("clicked", lambda *_: self._move_section(sec, index, SECTIONS[sec_i + 1]))
            h.append(right_btn)

        remove_btn = Gtk.Button.new_from_icon_name("edit-delete-symbolic")
        remove_btn.add_css_class("flat")
        remove_btn.set_tooltip_text("Remove from bar")
        remove_btn.connect("clicked", lambda *_: self._remove(sec, index))
        h.append(remove_btn)

        row.set_child(h)
        return row

    def _refresh_layout(self):
        layout = self.config.get("bar", {}).get("layout", {})
        global_q = (self._global_search.get_text() if self._global_search else "").strip().lower()

        for sec in SECTIONS:
            lb = self.section_boxes[sec]
            while (row := lb.get_row_at_index(0)) is not None:
                lb.remove(row)

            local_q = (self.search_entries.get(sec).get_text() if self.search_entries.get(sec) else "").strip().lower()
            entries = layout.get(sec, [])
            visible = []

            for i, entry in enumerate(entries):
                wid = entry.get("id", "")
                info = self.catalog.get(wid, {})
                bw = info.get("barWidget") or {}
                name = bw.get("displayName") or info.get("name") or wid
                desc = bw.get("description") or ""
                hay = f"{wid} {name} {desc}".lower()

                if local_q and local_q not in hay:
                    continue
                if global_q and global_q not in hay:
                    continue
                visible.append(i)

            count = len(entries)
            self.section_frames[sec].set_label(f"{SECTION_LABELS[sec]} section ({count})")
            for i in visible:
                lb.append(self._widget_row(sec, i, entries[i]))

    def _mark_dirty(self):
        if self._loading:
            return
        self.dirty = True
        self._status("Unsaved changes")

    def push_undo(self):
        before = copy.deepcopy(self.config)
        self._undo_stack.append(before)
        if len(self._undo_stack) > 100:
            self._undo_stack.pop(0)
        self._redo_stack.clear()

    def undo(self):
        if not self._undo_stack:
            return
        self._redo_stack.append(copy.deepcopy(self.config))
        self.config = self._undo_stack.pop()
        self._sync_ui_from_config()
        self._mark_dirty()
        self._refresh_layout()
        self._status("Undid last change")

    def redo(self):
        if not self._redo_stack:
            return
        self._undo_stack.append(copy.deepcopy(self.config))
        self.config = self._redo_stack.pop()
        self._sync_ui_from_config()
        self._mark_dirty()
        self._refresh_layout()
        self._status("Redid change")

    def _layout(self):
        bar = self.config.setdefault("bar", {})
        return bar.setdefault("layout", {"left": [], "center": [], "right": []})

    def _ordered_entries(self, sec):
        return self._layout()[sec]

    def _reorder(self, sec, index, delta):
        entries = self._ordered_entries(sec)
        target = index + delta
        if not (0 <= target < len(entries)):
            return
        self.push_undo()
        entries.insert(target, entries.pop(index))
        self._mark_dirty()
        self._refresh_layout()

    def _move_section(self, from_sec, index, to_sec):
        entries = self._ordered_entries(from_sec)
        if not (0 <= index < len(entries)):
            return
        entry = entries[index]
        wid = entry.get("id", "")
        to = self._ordered_entries(to_sec)

        info = self.catalog.get(wid, {})
        bw = info.get("barWidget") or {}
        allow_multi = bw.get("allowMultiple", False)

        if not allow_multi and any(e.get("id") == wid for e in to):
            self._status(f"'{wid}' is already in {SECTION_LABELS[to_sec].lower()} section")
            return

        self.push_undo()
        popped = entries.pop(index)
        to.append(popped)
        self._mark_dirty()
        self._refresh_layout()

    def _remove(self, sec, index):
        entries = self._ordered_entries(sec)
        if not (0 <= index < len(entries)):
            return
        self.push_undo()
        entries.pop(index)
        self._mark_dirty()
        self._refresh_layout()

    def _open_add(self, sec):
        def on_add(widget_id):
            self.push_undo()
            entry = {"id": widget_id}
            self._ordered_entries(sec).append(entry)

            # Ensure widget is not disabled in disabledPlugins
            if "disabledPlugins" in self.config and widget_id in self.config["disabledPlugins"]:
                self.config["disabledPlugins"].remove(widget_id)
                if not self.config["disabledPlugins"]:
                    self.config.pop("disabledPlugins", None)

            # If third-party non-bar-only plugin, ensure listed in plugins[]
            info = self.catalog.get(widget_id, {})
            if not info.get("firstParty", True):
                plugins = self.config.setdefault("plugins", [])
                if not any(p.get("id") == widget_id for p in plugins if isinstance(p, dict)):
                    plugins.append({"id": widget_id})

            self.states[widget_id] = True
            self._mark_dirty()
            self._refresh_layout()

        dialog = AddWidgetDialog(
            self,
            self.catalog,
            self.states,
            sec,
            already_placed=set(e.get("id") for s in self._layout().values() for e in s),
            cat_colors=self.CAT_COLORS,
            on_add=on_add,
        )
        dialog.present()

    def _open_config(self, entry):
        def on_save(updated):
            self.push_undo()
            for k, v in updated.items():
                entry[k] = v
            for k in [k for k in list(entry.keys()) if k not in updated and k != "id"]:
                del entry[k]
            self._mark_dirty()
            self._refresh_layout()

        dlg = WidgetConfigDialog(
            self, entry.get("id", ""), entry, self.catalog.get(entry.get("id", ""), {}), on_save=on_save
        )
        dlg.present()

    def _status(self, text):
        self.status.set_markup(f"<span color='grey'><small>{GLib.markup_escape_text(str(text))}</small></span>")

    def _notify(self, title, text):
        dlg = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text=title,
        )
        dlg.format_secondary_text(str(text))
        dlg.connect("response", lambda d, *_: d.destroy())
        dlg.present()

    def check_for_updates(self):
        repo_dir, current = get_update_info()
        if not repo_dir:
            self._notify(
                "Update unavailable",
                "This editor is not running from a git checkout, so there is no update source.\n"
                "Clone https://github.com/davidmessenger123/omarchy-bar-editor and run the script from there.",
            )
            return
        self.update_btn.set_sensitive(False)
        self._status("Checking for updates \u2026")
        threading.Thread(target=self._do_update, args=(repo_dir, current), daemon=True).start()

    def _do_update(self, repo_dir, current):
        fetch = run_cmd("git", "-C", repo_dir, "fetch", "origin", "main", timeout=60)
        if not fetch or fetch.returncode != 0:
            GLib.idle_add(self._reset_update_ui)
            err = (fetch.stderr if fetch else "") or "Could not reach the git remote."
            GLib.idle_add(self._notify, "Update check failed", err.strip())
            return

        behind = run_cmd("git", "-C", repo_dir, "rev-list", "--count", "HEAD..origin/main", timeout=10)
        if not behind or behind.returncode != 0:
            GLib.idle_add(self._reset_update_ui)
            GLib.idle_add(self._notify, "Update check failed", "Could not compare against origin/main.")
            return

        count = int(behind.stdout.strip() or 0)
        if count == 0:
            GLib.idle_add(self._reset_update_ui)
            GLib.idle_add(
                self._notify,
                "Up to date",
                f"The editor is already at the latest version ({current or 'HEAD'}).",
            )
            return
        GLib.idle_add(self._ask_pull, repo_dir, count)

    def _ask_pull(self, repo_dir, count):
        dlg = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text=f"{count} update{'s' if count != 1 else ''} available in the git checkout.",
        )
        dlg.format_secondary_text("Pull the latest version and restart the editor to apply it?")
        resp = dlg.run()
        dlg.destroy()
        if resp != Gtk.ResponseType.OK:
            self._reset_update_ui()
            return
        threading.Thread(target=self._pull_restart, args=(repo_dir,), daemon=True).start()

    def _pull_restart(self, repo_dir):
        pull = run_cmd("git", "-C", repo_dir, "pull", "--ff-only", "origin", "main", timeout=120)
        if not pull or pull.returncode != 0:
            GLib.idle_add(self._reset_update_ui)
            err = (pull.stderr if pull else "") or "git pull returned an error."
            GLib.idle_add(self._notify, "Update failed", err.strip())
            return
        GLib.idle_add(self._finish_update)

    def _finish_update(self):
        try:
            cmd = sys.argv[0]
            if not os.path.isabs(cmd):
                found = shutil.which(cmd)
                cmd = found or os.path.abspath(cmd)
            os.execv(cmd, [cmd] + sys.argv[1:])
        except Exception as e:
            self._reset_update_ui()
            self._notify(
                "Update applied",
                f"The checkout was updated, but the editor could not restart itself.\n\n{e}\nPlease close and reopen the editor.",
            )

    def _reset_update_ui(self):
        self.update_btn.set_sensitive(True)
        self._status("")

    def _sync_ui_from_config(self):
        self._loading = True
        try:
            bar = self.config.get("bar", {})
            pos = bar.get("position", "top")
            if pos in POSITIONS:
                self.position_dd.set_selected(POSITIONS.index(pos))
            self.transparent_switch.set_active(bool(bar.get("transparent", False)))

            anchor = bar.get("centerAnchor", "")
            self.center_anchor_entry.set_text(str(anchor) if anchor else "")

            host = bar.get("id", "omarchy.bar")
            hosts = list(self._hosts or [])
            if host in hosts:
                self.host_dd.set_selected(hosts.index(host))

            idle = self.config.get("idle") or {}
            self.screensaver_spin.set_value(int(idle.get("screensaver", 150)))
            self.lock_spin.set_value(int(idle.get("lock", 300)))
        finally:
            self._loading = False

    def reload_from_disk(self):
        self._loading = True
        try:
            with open(CONFIG_PATH) as f:
                self.config = json.load(f)
        except (OSError, json.JSONDecodeError) as e:
            self._status(f"Could not read {CONFIG_PATH}: {e}")
            self.config = {}

        bar = self.config.setdefault("bar", {})
        layout = bar.setdefault("layout", {})
        for sec in SECTIONS:
            layout.setdefault(sec, [])
            layout[sec] = [e if isinstance(e, dict) else {"id": str(e)} for e in layout[sec]]

        self._sync_ui_from_config()

        sv, _ = ShellToml.load()
        self._shell_toml_values = sv
        self.bg_color_entry.set_text(sv.get("background", ""))
        self.text_color_entry.set_text(sv.get("text", ""))
        self.active_color_entry.set_text(sv.get("active", ""))

        color_map = {
            "bg_color": "background",
            "text_color": "text",
            "active_color": "active",
        }
        for key, skey in color_map.items():
            hexv = sv.get(skey, "")
            if re.match(r"^#[0-9a-fA-F]{6}$", hexv):
                try:
                    rgba = Gdk.RGBA()
                    rgba.red = int(hexv[1:3], 16) / 255.0
                    rgba.green = int(hexv[3:5], 16) / 255.0
                    rgba.blue = int(hexv[5:7], 16) / 255.0
                    rgba.alpha = 1.0
                    getattr(self, f"{key}_swatch").set_rgba(rgba)
                except Exception:
                    pass

        self.bg_alpha_spin.set_value(float(sv.get("background_alpha", "1.0")))
        self.size_h_spin.set_value(int(sv.get("size_horizontal", "26")))
        self.size_v_spin.set_value(int(sv.get("size_vertical", "28")))
        self.scale_font_switch.set_active(str(sv.get("scale_with_font", "true")).lower() == "true")

        self._update_bar_off_state()
        self._undo_stack.clear()
        self._redo_stack.clear()
        self.dirty = False
        self._toml_dirty = False
        self._loading = False

        self._refresh_layout()
        self._status("Loaded from disk")

    def _gather(self):
        cfg = copy.deepcopy(self.config)
        bar = cfg.setdefault("bar", {})
        layout = self._layout()
        bar["layout"] = layout

        idx = self.position_dd.get_selected()
        bar["position"] = POSITIONS[idx if 0 <= idx < len(POSITIONS) else 0]
        bar["transparent"] = self.transparent_switch.get_active()

        anchor = self.center_anchor_entry.get_text().strip()
        if anchor:
            bar["centerAnchor"] = anchor
        else:
            bar.pop("centerAnchor", None)

        hidx = self.host_dd.get_selected()
        host = self._hosts[hidx if 0 <= hidx < len(self._hosts) else 0]
        if host == "omarchy.bar":
            bar.pop("id", None)
        else:
            bar["id"] = host

        ss_val = int(self.screensaver_spin.get_value())
        lk_val = int(self.lock_spin.get_value())
        if ss_val > 0 or lk_val > 0:
            idle = cfg.setdefault("idle", {})
            idle["screensaver"] = ss_val
            idle["lock"] = lk_val
        else:
            cfg.pop("idle", None)

        cfg["version"] = 1
        return cfg

    def _gather_shell_toml(self):
        sv = dict(self._shell_toml_values or ShellToml.DEFAULTS)
        sv["background"] = self.bg_color_entry.get_text().strip() or sv.get("background", "")
        sv["text"] = self.text_color_entry.get_text().strip() or sv.get("text", "")
        sv["active"] = self.active_color_entry.get_text().strip() or sv.get("active", "")
        sv["background_alpha"] = str(round(self.bg_alpha_spin.get_value(), 2))
        sv["size_horizontal"] = str(int(self.size_h_spin.get_value()))
        sv["size_vertical"] = str(int(self.size_v_spin.get_value()))
        sv["scale_with_font"] = "true" if self.scale_font_switch.get_active() else "false"
        return sv

    def save(self):
        cfg = self._gather()
        before_text = ""
        try:
            with open(CONFIG_PATH) as f:
                before_text = f.read()
        except OSError:
            pass
        after_text = json.dumps(cfg, indent=2, ensure_ascii=False) + "\n"

        toml_before = ""
        toml_after = ""
        if self._toml_dirty or os.path.exists(SHELL_TOML_PATH):
            toml_vals = self._gather_shell_toml()
            try:
                if os.path.exists(SHELL_TOML_PATH):
                    with open(SHELL_TOML_PATH) as f:
                        toml_before = f.read()
            except OSError:
                pass
            toml_after = ShellToml.format_toml(toml_vals, toml_before)

        def on_confirm():
            self._write_config(cfg)
            if self._toml_dirty or os.path.exists(SHELL_TOML_PATH):
                self._write_shell_toml(self._gather_shell_toml())
            self.dirty = False
            self._toml_dirty = False
            self.config = cfg

        self._diff_dialog = DiffDialog(
            self,
            before_text,
            after_text,
            toml_before=toml_before,
            toml_after=toml_after,
            on_save=on_confirm,
        )
        self._diff_dialog.present()

    def _write_config(self, cfg):
        try:
            os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
            if os.path.exists(CONFIG_PATH):
                shutil.copy2(CONFIG_PATH, CONFIG_PATH + ".bak-editor")
                stat = os.stat(CONFIG_PATH)
            else:
                stat = None

            fd, tmp = tempfile.mkstemp(dir=os.path.dirname(CONFIG_PATH))
            with os.fdopen(fd, "w") as f:
                json.dump(cfg, f, indent=2, ensure_ascii=False)
                f.write("\n")

            if stat:
                os.chmod(tmp, stat.st_mode)
            else:
                os.chmod(tmp, 0o644)
            os.replace(tmp, CONFIG_PATH)
            self._status(f"Saved {CONFIG_PATH} — shell reloads automatically")
        except OSError as e:
            self._status(f"Save failed: {e}")

    def _write_shell_toml(self, values):
        try:
            ShellToml.save(values)
            self._shell_toml_values = dict(values)
        except OSError as e:
            self._status(f"shell.toml save failed: {e}")

    def confirm_reset(self):
        dlg = Gtk.Dialog(modal=True, transient_for=self)
        dlg.set_title("Confirm Reset")
        dlg.set_default_size(440, 180)

        bwa = dlg.get_content_area()
        bwa.set_margin_top(16)
        bwa.set_margin_bottom(16)
        bwa.set_margin_start(16)
        bwa.set_margin_end(16)

        lbl = Gtk.Label(wrap=True)
        lbl.set_markup(
            "<b>Reset bar to default Omarchy layout?</b>\n\n"
            "This will restore stock widgets and clear custom widget options."
        )
        bwa.append(lbl)

        dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
        ok = dlg.add_button("Reset", Gtk.ResponseType.OK)
        ok.add_css_class("destructive-action")

        def on_resp(_d, resp):
            if resp == Gtk.ResponseType.OK:
                self.push_undo()
                proc = run_cmd("omarchy", "bar", "defaults", timeout=20)
                if proc and proc.returncode == 0:
                    self.reload_from_disk()
                    self._status("Reset to default Omarchy bar")
                else:
                    self._status("Reset command failed")
            dlg.destroy()

        dlg.connect("response", on_resp)
        dlg.present()

    def _bar_off_exists(self):
        return os.path.exists(BAR_OFF_FLAG)

    def _update_bar_off_state(self):
        exists = self._bar_off_exists()
        self.bar_off_btn.set_label("Bar: off" if exists else "Bar: on")

    def toggle_bar_off(self):
        run_cmd("omarchy", "toggle", "bar", timeout=10)
        self._update_bar_off_state()
        self._status("Bar hidden" if self._bar_off_exists() else "Bar visible")

    def open_profiles(self):
        def on_save_payload():
            return {
                "layout": copy.deepcopy(self._layout()),
                "position": self._position_value(),
                "transparent": self.transparent_switch.get_active(),
                "centerAnchor": self.center_anchor_entry.get_text().strip(),
            }

        def on_load_payload(payload):
            self.push_undo()
            layout = self._layout()
            saved_layout = payload.get("layout") or {}
            for s in SECTIONS:
                layout[s] = [e if isinstance(e, dict) else {"id": str(e)} for e in saved_layout.get(s, [])]
            if "position" in payload and payload["position"] in POSITIONS:
                self.position_dd.set_selected(POSITIONS.index(payload["position"]))
            if "transparent" in payload:
                self.transparent_switch.set_active(bool(payload["transparent"]))
            if "centerAnchor" in payload:
                self.center_anchor_entry.set_text(str(payload.get("centerAnchor", "")))
            self._mark_dirty()
            self._refresh_layout()
            self._status("Loaded profile")

        dlg = ProfileDialog(self, on_save_payload, on_load_payload)
        dlg.present()

    def _position_value(self):
        ix = self.position_dd.get_selected()
        return POSITIONS[ix if 0 <= ix < len(POSITIONS) else 0]

    def open_plugins(self):
        def on_changed():
            self._mark_dirty()

        dlg = PluginManagerDialog(self, self.config, self.catalog, self.states, on_changed=on_changed)
        dlg.present()


class BarEditorApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.set_accels_for_action("win.undo", ["<Ctrl>z"])
        self.set_accels_for_action("win.redo", ["<Ctrl><Shift>z", "<Ctrl>y"])
        self.set_accels_for_action("win.save", ["<Ctrl>s"])
        self.set_accels_for_action("win.reload", ["<Ctrl>r"])
        self.set_accels_for_action("win.plugins", ["<Ctrl>p"])
        self.set_accels_for_action("win.focus-search", ["<Ctrl>f"])

    def do_activate(self):
        win = BarEditorWindow(self)
        win.present()


def main():
    app = BarEditorApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
