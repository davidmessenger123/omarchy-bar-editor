        title = Gtk.Label(halign=Gtk.Align.START)
        title.set_markup("<b><big>Layout profiles</big></b>")
        bwa.append(title)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self._name = Gtk.Entry()
        self._name.set_placeholder_text("New profile name...")
        self._name.set_hexpand(True)
        self._name.connect("activate", lambda *_: self._do_save())
        row.append(self._name)

        save_btn = Gtk.Button(label="Save current")
        save_btn.add_css_class("suggested-action")
        save_btn.connect("clicked", lambda *_: self._do_save())
        row.append(save_btn)
        bwa.append(row)

        sw = Gtk.ScrolledWindow()
        sw.set_vexpand(True)
        bwa.append(sw)

        self._listbox = Gtk.ListBox()
        sw.set_child(self._listbox)

        self.dialog.add_button("Close", Gtk.ResponseType.CLOSE)
        self.dialog.connect("response", lambda _d, _r: self.dialog.destroy())
        self._refresh()

    def _profile_path(self, name):
        return os.path.join(PROFILES_DIR, name + ".json")

    def _refresh(self):
        if self._listbox is None:
            return
        while (row := self._listbox.get_row_at_index(0)) is not None:
            self._listbox.remove(row)

        try:
            files = sorted(f for f in os.listdir(PROFILES_DIR) if f.endswith(".json"))
        except OSError:
            files = []

        for fn in files:
            name = fn[:-5]
            row = Gtk.ListBoxRow()
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            box.set_margin_top(4)
            box.set_margin_bottom(4)
            box.set_margin_start(8)
            box.set_margin_end(8)

            lbl = Gtk.Label(label=name, hexpand=True, xalign=0)
            box.append(lbl)

            load_btn = Gtk.Button(label="Load")
            load_btn.connect("clicked", lambda _b, n=name: self._do_load(n))
            box.append(load_btn)

            del_btn = Gtk.Button.new_from_icon_name("edit-delete-symbolic")
            del_btn.add_css_class("flat")
            del_btn.set_tooltip_text("Delete profile")
            del_btn.connect("clicked", lambda _b, n=name: self._do_delete(n))
            box.append(del_btn)

            row.set_child(box)
            self._listbox.append(row)

    def _do_save(self):
        name = self._name.get_text().strip()
        if not name:
            return
        os.makedirs(PROFILES_DIR, exist_ok=True)
        payload = self.on_save()
        path = self._profile_path(name)
        fd, tmp = tempfile.mkstemp(dir=PROFILES_DIR)
        with os.fdopen(fd, "w") as f:
            json.dump(payload, f, indent=2, ensure_ascii=False)
            f.write("\n")
        os.replace(tmp, path)
        self._name.set_text("")
        self._refresh()

    def _do_load(self, name):
        path = self._profile_path(name)
        try:
            with open(path) as f:
                payload = json.load(f)
        except (OSError, json.JSONDecodeError):
            return
        self.on_load(payload)
        self.dialog.destroy()

    def _do_delete(self, name):
        try:
            os.remove(self._profile_path(name))
        except OSError:
            pass
        self._refresh()

    def present(self):
        self.dialog.present()


class DiffDialog:
    """Show a visual side-by-side or tabbed diff before saving."""

    def __init__(self, window, json_before, json_after, toml_before="", toml_after="", on_save=None):
        self.on_save = on_save
        self.dialog = Gtk.Dialog(modal=True, transient_for=window)
        self.dialog.set_title("Review Changes Before Saving")
        self.dialog.set_default_size(840, 560)

        bwa = self.dialog.get_content_area()
        bwa.set_spacing(10)
        bwa.set_margin_top(12)
        bwa.set_margin_bottom(12)
        bwa.set_margin_start(12)
        bwa.set_margin_end(12)

        title = Gtk.Label(halign=Gtk.Align.START)
        title.set_markup("<b><big>Review changes before saving</big></b>")
        bwa.append(title)

        has_toml_diff = bool(toml_before or toml_after) and (toml_before != toml_after)
        notebook = Gtk.Notebook()
        notebook.set_hexpand(True)
        notebook.set_vexpand(True)

        json_view = self._create_diff_view(json_before, json_after)
        notebook.append_page(json_view, Gtk.Label(label="shell.json"))

        if has_toml_diff:
            toml_view = self._create_diff_view(toml_before, toml_after)
            notebook.append_page(toml_view, Gtk.Label(label="shell.toml"))

        bwa.append(notebook)

        self.dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        ok = self.dialog.add_button("Save changes", Gtk.ResponseType.OK)
        ok.add_css_class("suggested-action")

        self.dialog.connect("response", self._on_response)

    def _create_diff_view(self, before_text, after_text):
        grid = Gtk.Grid()
        grid.set_column_spacing(10)
        grid.set_row_spacing(6)
        grid.set_hexpand(True)
        grid.set_vexpand(True)

        lbl1 = Gtk.Label(label="Before", halign=Gtk.Align.START)
        lbl1.add_css_class("heading")
        grid.attach(lbl1, 0, 0, 1, 1)

        lbl2 = Gtk.Label(label="After", halign=Gtk.Align.START)
        lbl2.add_css_class("heading")
        grid.attach(lbl2, 1, 0, 1, 1)

        txt1 = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.NONE)
        buf1 = txt1.get_buffer()
        buf1.set_text(before_text)

        txt2 = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.NONE)
        buf2 = txt2.get_buffer()
        buf2.set_text(after_text)

        tag_del = buf1.create_tag("removed", background="#381d22", foreground="#f7768e")
        tag_add = buf2.create_tag("added", background="#1d3826", foreground="#9ece6a")

        s1 = before_text.splitlines()
        s2 = after_text.splitlines()
        matcher = difflib.SequenceMatcher(None, s1, s2)

        for tag, i1, i2, j1, j2 in matcher.get_opcodes():
            if tag in ("delete", "replace"):
                _, start = buf1.get_iter_at_line(i1)
                end = buf1.get_iter_at_line(i2)[1] if i2 < len(s1) else buf1.get_end_iter()
                buf1.apply_tag(tag_del, start, end)
            if tag in ("insert", "replace"):
                _, start = buf2.get_iter_at_line(j1)
                end = buf2.get_iter_at_line(j2)[1] if j2 < len(s2) else buf2.get_end_iter()
                buf2.apply_tag(tag_add, start, end)

        sw1 = Gtk.ScrolledWindow(hexpand=True, vexpand=True, child=txt1)
        sw2 = Gtk.ScrolledWindow(hexpand=True, vexpand=True, child=txt2)
        grid.attach(sw1, 0, 1, 1, 1)
        grid.attach(sw2, 1, 1, 1, 1)
        return grid

    def _on_response(self, dialog, response):
        if response == Gtk.ResponseType.OK and self.on_save:
            self.on_save()
        self.dialog.destroy()

    def present(self):
        self.dialog.present()


